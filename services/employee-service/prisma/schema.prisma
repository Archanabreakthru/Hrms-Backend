datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["employee"]
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model EmployeeSequence {
  prefix     String   @id @map("prefix")
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("employee_sequences")
  @@schema("employee")
}

model Employee {
  id                     String    @id @map("id") @db.VarChar(50)
  originalLegacyId       String?   @unique @map("original_legacy_id") @db.VarChar(50)
  userId                 String?   @unique @map("user_id") @db.Uuid
  firstName              String    @map("first_name") @db.VarChar(100)
  lastName               String    @map("last_name") @db.VarChar(100)
  email                  String    @unique @map("official_email") @db.VarChar(255)
  phone                  String    @map("phone") @db.VarChar(20)
  personalEmail          String?   @map("personal_email") @db.VarChar(255)
  personalPhone          String?   @map("personal_phone") @db.VarChar(20)
  avatarUrl              String?   @map("avatar_url") @db.Text
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  gender                 String?   @map("gender") @db.VarChar(20)
  bloodGroup             String?   @map("blood_group") @db.VarChar(10)
  maritalStatus          String?   @map("marital_status") @db.VarChar(20)
  currentAddress         String?   @map("current_address") @db.Text
  permanentAddress       String?   @map("permanent_address") @db.Text
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactRelationship String? @map("emergency_contact_relationship") @db.VarChar(50)
  emergencyContactPhone  String?   @map("emergency_contact_phone") @db.VarChar(20)
  
  // Organization Links
  departmentId           String?   @map("department_id") @db.Uuid
  designationId          String?   @map("designation_id") @db.Uuid
  branchId               String?   @map("branch_id") @db.Uuid
  shiftId                String?   @map("shift_id") @db.Uuid
  reportingManagerId     String?   @map("reporting_manager_id") @db.VarChar(50)
  employmentType         String    @default("Permanent") @map("employment_type") @db.VarChar(50)
  employeeCategory       String    @default("Core Staff") @map("employee_category") @db.VarChar(50)
  status                 String    @default("Active") @map("employment_status") @db.VarChar(50)
  profileStatus          String    @default("Active") @map("profile_status") @db.VarChar(50)
  
  // Dates & Lifecycle
  dateOfJoining          DateTime  @map("date_of_joining") @db.Date
  confirmationDate       DateTime? @map("confirmation_date") @db.Date
  probationPeriodDays    Int?      @default(180) @map("probation_period_days")
  noticePeriodDays       Int       @default(60) @map("notice_period_days")
  dateOfSeparation       DateTime? @map("date_of_separation") @db.Date
  separationReason       String?   @map("separation_reason") @db.Text
  isActive               Boolean   @default(true) @map("is_active")

  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([departmentId])
  @@index([designationId])
  @@index([branchId])
  @@index([reportingManagerId])
  @@index([profileStatus])
  @@map("employees")
  @@schema("employee")
}

model ProvisioningOutbox {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.VarChar(50)
  email       String   @map("email") @db.VarChar(255)
  payload     Json     @map("payload")
  status      String   @default("PENDING") @map("status") @db.VarChar(50)
  attempts    Int      @default(0) @map("attempts")
  lastError   String?  @map("last_error") @db.Text
  nextRetryAt DateTime @default(now()) @map("next_retry_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRetryAt], map: "idx_employee_outbox_queue")
  @@map("provisioning_outbox")
  @@schema("employee")
}
