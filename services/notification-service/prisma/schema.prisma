datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/notification-client"
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPROVAL_REQUEST
  ACTION_REQUIRED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id          String               @id @default(uuid())
  recipientId String               // Employee ID / User ID
  tenantId    String?              // Optional client tenant if external
  title       String
  message     String
  type        NotificationType     @default(INFO)
  priority    NotificationPriority @default(MEDIUM)
  channel     NotificationChannel  @default(IN_APP)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  linkUrl     String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([recipientId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id          String   @id @default(uuid())
  templateKey String   @unique
  name        String
  subject     String
  bodyText    String
  bodyHtml    String?
  channels    String[] // e.g. ["IN_APP", "EMAIL"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_templates")
}

model AuditLog {
  id           String   @id @default(uuid())
  serviceName  String
  action       String   // e.g. "USER_LOGIN", "PAYROLL_EXECUTE", "ATTENDANCE_REGULARIZE"
  resourceType String   // e.g. "PayrollRun", "Employee", "AttendanceRecord"
  resourceId   String?
  actorId      String   // Employee ID / User ID who performed the action
  actorRole    String?
  actorIp      String?
  details      Json?
  diff         Json?
  correlationId String?
  timestamp    DateTime @default(now())

  @@index([serviceName, action])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

