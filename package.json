{
  "name": "orbyx-hrms-backend",
  "version": "1.0.0",
  "description": "Orbyx HRMS - Backend Service",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node scripts/startAllServices.js",
    "test": "node --test services/asset-service/tests/asset.test.js services/attendance-service/tests/attendance.test.js services/auth-service/tests/auth.test.js services/client-service/tests/client.test.js services/employee-service/tests/employee.test.js services/expense-service/tests/expense.test.js services/notification-service/tests/notification.test.js services/organization-service/tests/org.test.js services/payroll-service/tests/payroll.test.js api-gateway/tests/gateway.test.js shared/tests/shared.test.js",
    "prisma:generate:auth": "prisma generate --schema=services/auth-service/prisma/schema.prisma",
    "prisma:generate:org": "prisma generate --schema=services/organization-service/prisma/schema.prisma",
    "prisma:generate:employee": "prisma generate --schema=services/employee-service/prisma/schema.prisma",
    "prisma:generate:attendance": "prisma generate --schema=services/attendance-service/prisma/schema.prisma",
    "prisma:generate:expense": "prisma generate --schema=services/expense-service/prisma/schema.prisma",
    "prisma:generate:asset": "prisma generate --schema=services/asset-service/prisma/schema.prisma",
    "prisma:generate:client": "prisma generate --schema=services/client-service/prisma/schema.prisma",
    "prisma:generate:notification": "prisma generate --schema=services/notification-service/prisma/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate:auth && npm run prisma:generate:org && npm run prisma:generate:employee && npm run prisma:generate:attendance && npm run prisma:generate:expense && npm run prisma:generate:asset && npm run prisma:generate:client && npm run prisma:generate:notification"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
